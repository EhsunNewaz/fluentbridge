# FluentBridge Environment Variables
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
REACT_APP_SUPABASE_URL=your_supabase_project_url
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key

# Application Configuration
REACT_APP_APP_NAME="FluentBridge"
REACT_APP_APP_VERSION="0.1.0-dev"
REACT_APP_ENVIRONMENT="development"

# API Configuration
REACT_APP_API_BASE_URL="http://localhost:3000/api"

# Bengali Fonts Configuration
REACT_APP_BENGALI_FONT_PRIMARY="Kalpurush"
REACT_APP_BENGALI_FONT_FALLBACK="SolaimanLipi"

# Feature Flags
REACT_APP_ENABLE_PHONICS_ASSESSMENT=true
REACT_APP_ENABLE_COMMUNITY_FEATURES=false
REACT_APP_ENABLE_MOCK_TESTING=true
REACT_APP_ENABLE_BENGALI_TOGGLE=true

# Analytics (Optional)
REACT_APP_GOOGLE_ANALYTICS_ID=""
REACT_APP_ENABLE_ANALYTICS=false

# Development Settings
REACT_APP_DEBUG_MODE=true
REACT_APP_SHOW_PERFORMANCE_METRICS=true

